# Public site URL — used in outreach emails and Stripe redirects
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Database — SQLite for dev, swap to Postgres for prod (Vercel/Supabase/Neon)
DATABASE_URL="file:./dev.db"

# Owner contact — payment notifications land here, also the "from" name on outreach
OWNER_NAME="Your Name"
OWNER_EMAIL="you@example.com"

# Admin dashboard password (HTTP Basic Auth; any username works)
ADMIN_PASSWORD="change-me"

# ─── REQUIRED ─────────────────────────────────────────────────────────────

# Anthropic API — mockup copy generation (claude-opus-4-7)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Places API — lead discovery (enable Places API (New) in Google Cloud)
GOOGLE_PLACES_API_KEY=""

# Stripe — payments
# Use test keys (sk_test_/pk_test_) until you're ready to charge real cards
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_USD_CENTS="65000"

# Resend — email sender for outreach + payment notifications
RESEND_API_KEY=""
# Must be a verified sender domain in Resend. While testing, "onboarding@resend.dev" works.
RESEND_FROM="Sites <onboarding@resend.dev>"

# ─── OPTIONAL ENRICHMENT / ALT CHANNELS ───────────────────────────────────

# Hunter.io — auto-populates lead.email at discovery time when the business
# has a domain Hunter can search. No-op when not set.
HUNTER_API_KEY=""

# Twilio — SMS outreach as an alternative to email. Used when a lead has a
# phone number but no email (the common case for SMBs without websites).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Vercel — auto-deploy the customer's site immediately after Stripe payment.
# When set, the Stripe webhook publishes the AI mockup to a fresh Vercel
# deployment URL and emails that URL to the customer with the intake form.
# Skipped silently when not set.
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
