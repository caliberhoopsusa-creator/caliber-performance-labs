# Copy to .env and fill in. The server reads these; the browser never sees them.

# Required — your Anthropic API key (https://console.anthropic.com).
# Billing only happens when /api/analyze actually calls the model.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — port the Express API listens on (default 5174).
PORT=5174

# Optional — max /api/analyze requests per IP per minute (default 20).
RATE_LIMIT_PER_MINUTE=20
