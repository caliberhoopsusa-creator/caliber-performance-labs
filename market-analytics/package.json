{
  "name": "quanta-market-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered quantitative market analytics — a standalone SaaS built on Claude.",
  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "marked": "^14.1.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
